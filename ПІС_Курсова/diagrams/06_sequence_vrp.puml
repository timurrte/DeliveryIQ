@startuml Sequence_VRP
!theme plain
skinparam sequenceMessageAlign center

title Діаграма послідовності -- Оптимізація VRP (декілька транспортних засобів)

actor "Оператор" as User
participant "app.py" as App
participant "vrp_solver.py\n(VRPSolver)" as VRP
participant "route_solver.py\n(RouteSolver)" as RS
participant "graph_builder.py" as GB

User -> App : Налаштовує парк ТЗ\n(тип, місткість) та\nнатискає "Optimize Fleet"

activate App

App -> VRP : solve_vrp(depot, stops, fleet,\nmode_graphs, G_raw, radius)
activate VRP

== Фаза 1: Призначення зупинок до типів ТЗ ==

loop для кожної зупинки
    loop для кожного типу ТЗ (drive, bike, walk)
        VRP -> RS : build_distance_matrix(\nG_mode, [depot, stop], "travel_time")
        RS --> VRP : matrix — час досяжності
    end
    VRP -> VRP : _assign_stops_to_modes():\nобрати тип ТЗ з найбільшим\nзалишком місткості серед\nсумісних режимів
end

== Фаза 2: Генетичний алгоритм у межах пулу режиму ==

loop для кожного режиму (drive, bike, walk)

    VRP -> RS : build_distance_matrix(\nG_mode, [depot] + pool_stops)
    activate RS
    RS --> VRP : matrix (часи між усіма\nвузлами пулу)
    deactivate RS

    VRP -> VRP : _build_ga_routes(pool, fleet_mode, matrix)
    activate VRP #LightBlue

    note right
      <b>Ініціалізація популяції</b> (50 хромосом):
      • 1 хромосома — _nearest_neighbour_seed()
        («теплий старт»)
      • 49 хромосом — випадкові перестановки
    end note

    loop GA: N_GENERATIONS = 150
        VRP -> VRP : _tournament_select()\n(турнір 3 особин)
        VRP -> VRP : _order_crossover()\n(OX, p = 0.85)
        VRP -> VRP : _swap_mutation()\n(swap, p = 0.15)
        VRP -> VRP : _evaluate():\n_decode_chromosome (Split)\n→ F = A·T_total + B·K + P·|U|
        VRP -> VRP : Елітизм (ELITE_SIZE = 2):\nперенести 2 найкращі\nособини у нове покоління
    end

    VRP --> VRP : best_chromosome
    deactivate VRP

end

== Фаза 3: Декодування переможця та реконструкція маршрутів ==

loop для кожного режиму
    VRP -> VRP : _decode_chromosome(best, …)\n→ список VehicleRoute
end

loop для кожного ТЗ (vehicle)
    VRP -> RS : reconstruct_full_route(\nG_mode, tsp_route)
    activate RS
    RS --> VRP : full_route (повна\nпослідовність вузлів)
    deactivate RS
end

VRP --> App : (list[VehicleRoute],\nwarnings)
deactivate VRP

App --> User : Карта з маршрутами\nкожного ТЗ різними\nкольорами + таблиця

deactivate App

@enduml
